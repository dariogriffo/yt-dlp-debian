#!/usr/bin/make -f

# The upstream release tarball already contains everything we ship: the
# self-contained zipapp, the man page and the shell completions. Nothing is
# compiled and nothing is downloaded at build time.

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_clean:

override_dh_auto_install:
	install -D -m 755 yt-dlp debian/yt-dlp/usr/bin/yt-dlp
	install -D -m 644 completions/bash/yt-dlp \
		debian/yt-dlp/usr/share/bash-completion/completions/yt-dlp
	install -D -m 644 completions/zsh/_yt-dlp \
		debian/yt-dlp/usr/share/zsh/vendor-completions/_yt-dlp
	install -D -m 644 completions/fish/yt-dlp.fish \
		debian/yt-dlp/usr/share/fish/vendor_completions.d/yt-dlp.fish

override_dh_strip:

override_dh_shlibdeps:
